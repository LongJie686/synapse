# Frontend environment variables
# Copy to .env.local and fill in values

# Backend URL for SSE streaming (bypasses Next.js proxy)
# Required in production. Leave blank for same-origin (dev with proxy).
NEXT_PUBLIC_API_URL=

# API key matching the backend API_KEY env var
# Required when backend has API_KEY set.
NEXT_PUBLIC_API_KEY=

# Backend URL for Next.js server-side proxy rewrites (not exposed to browser)
BACKEND_URL=http://localhost:8000

# Synapse Environment Variables
# Copy this to .env and fill in your keys

# LLM Providers
OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=sk-ant-xxx

# Search
TAVILY_API_KEY=tvly-xxx

# Database
DATABASE_URL=postgresql+asyncpg://synapse:synapse@localhost:5432/synapse

# Redis
REDIS_URL=redis://localhost:6379

# LangSmith (optional)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=synapse

# Logging
LOG_LEVEL=INFO

# Security
# API key required by all /api/* endpoints (leave blank to disable auth in dev)
API_KEY=
# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000
# Set to "true" only when running behind a trusted reverse proxy (Nginx, ALB, etc.)
TRUST_PROXY=false
